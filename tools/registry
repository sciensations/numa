#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
EXERCISES="$ROOT/content/exercises"
REGISTRY="$ROOT/content/exercise-registry.typ"
TEMPORARY="$(mktemp "$ROOT/content/.exercise-registry.XXXXXX")"
trap 'rm -f "$TEMPORARY"' EXIT

files=("$EXERCISES"/[0-9][0-9][0-9][0-9].typ)
[[ -e "${files[0]}" ]] || {
  printf 'error: content/exercises contains no numbered Typst files\n' >&2
  exit 1
}

{
  printf '%s\n' '// Generated by tools/registry. Do not edit by hand.'
  printf '%s\n' '// Add or remove a numbered content/exercises/*.typ file, then run `just registry`.'

  for path in "${files[@]}"; do
    stem="$(basename "$path" .typ)"
    printf '#import "exercises/%s.typ": item as ex%s\n' "$stem" "$stem"
  done

  printf '\n#let exercises = ('
  separator=""
  for path in "${files[@]}"; do
    stem="$(basename "$path" .typ)"
    printf '%s%s' "$separator" "ex$stem"
    separator=', '
  done
  printf ',)\n\n'

  cat <<'TYPST'
#let exercise-at(serial) = {
  let matches = exercises.filter(item => item.serial == serial)
  assert(matches.len() == 1, message: "unknown or duplicate exercise serial " + str(serial))
  matches.first()
}
TYPST
} >"$TEMPORARY"

if [[ "${1:-}" == "--check" ]]; then
  if [[ ! -f "$REGISTRY" ]] || ! cmp -s "$TEMPORARY" "$REGISTRY"; then
    diff -u "$REGISTRY" "$TEMPORARY" || true
    printf 'error: exercise registry is stale; run: just registry\n' >&2
    exit 1
  fi
else
  mv "$TEMPORARY" "$REGISTRY"
  trap - EXIT
  printf 'Generated content/exercise-registry.typ\n'
fi
